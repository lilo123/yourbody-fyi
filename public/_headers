# Cloudflare Pages custom response headers
# Global rules: Base security headers and revalidation caching applied across all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://o4512229258690560.ingest.us.sentry.io capacitor://localhost https://cloudflareinsights.com; img-src 'self' data: blob: https:; script-src 'self' https://static.cloudflareinsights.com; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; object-src 'none'; base-uri 'self';
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate

/
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://www.yourbody.fyi/>; rel="canonical"

/terms
  Link: <https://www.yourbody.fyi/terms>; rel="canonical"

/privacy
  Link: <https://www.yourbody.fyi/privacy>; rel="canonical"

/refunds
  Link: <https://www.yourbody.fyi/refunds>; rel="canonical"

# Signed-in app routes: Disallow search indexing
/workout
  X-Robots-Tag: noindex

/workout/*
  X-Robots-Tag: noindex

/nutrition
  X-Robots-Tag: noindex

/nutrition/*
  X-Robots-Tag: noindex

/history
  X-Robots-Tag: noindex

/history/*
  X-Robots-Tag: noindex

/exercises
  X-Robots-Tag: noindex

/exercises/*
  X-Robots-Tag: noindex

/coach
  X-Robots-Tag: noindex

/coach/*
  X-Robots-Tag: noindex

/settings
  X-Robots-Tag: noindex

/settings/*
  X-Robots-Tag: noindex

/login
  X-Robots-Tag: noindex

/login/*
  X-Robots-Tag: noindex

/reset-password
  X-Robots-Tag: noindex

/reset-password/*
  X-Robots-Tag: noindex

/*.html
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  ! Cache-Control
  Cache-Control: no-cache

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-image.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/workbox-*
  ! Cache-Control
  Cache-Control: no-cache

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: no-cache

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Content-Type: text/plain

/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Content-Type: application/xml

/version.json
  ! Cache-Control
  Cache-Control: no-cache
