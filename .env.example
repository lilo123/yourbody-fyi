# Yourbody V2 Client Environment Variables
# Both VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are strictly required in production builds (import.meta.env.PROD).
# In development (import.meta.env.DEV), missing values fall back to local Supabase emulator defaults.
VITE_SUPABASE_URL=http://127.0.0.1:58821
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

